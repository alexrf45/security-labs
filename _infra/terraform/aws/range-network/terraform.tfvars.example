# Copy to terraform.tfvars and SOPS-encrypt before committing (secrets.md).
# terraform.tfvars is gitignored; this .example is not and must hold no secrets.

# project           = "security-labs"
# aws_region        = "us-east-1"
# availability_zone = "us-east-1a"

# Budget alarm recipients (50/80/100 percent of the ceiling). Your own address;
# not committed to the repo. Leave unset to create the budget without alarms.
# budget_alert_emails = ["you@example.com"]

