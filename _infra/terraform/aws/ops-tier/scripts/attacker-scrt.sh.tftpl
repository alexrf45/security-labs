#!/usr/bin/env bash
# =============================================================================
# Attacker box provisioning — reproduces the user's SCRT daily-driver image
# (github.com/alexrf45/SCRT) on the Kali EC2 host by running SCRT's own build
# scripts, then adds an i3 desktop (over xrdp) and tmux. The attacker sits on the
# routed ops subnet, so it has internet to clone/download (unlike victim hosts).
# Reached over Tailscale via the subnet router: SSH, or RDP to i3 on 3389.
# =============================================================================
set -uxo pipefail
exec > >(tee -a /var/log/attacker-bootstrap.log) 2>&1

# Egress is NAT through the router, which may still be booting.
for _ in $(seq 1 60); do
  curl -sS -o /dev/null --max-time 5 https://http.kali.org && break
  sleep 5
done

SCRT_REPO="${scrt_repo_url}"
INSTALL_BUGBOUNTY="${install_bugbounty}"
ENABLE_GUI="${enable_gui}"
KALI_USER="kali"
KALI_HOME="/home/$KALI_USER"

# xtrace (set -x above) is deliberate: first-boot debugging depends on it. But xtrace
# prints every expansion, and BOTH sinks are world-readable 0644 —
# /var/log/attacker-bootstrap.log (line above) and /var/log/cloud-init-output.log.
# So the password must never be expanded while tracing is on. Guarded here at the
# assignment and again at every use below.
set +x
RDP_PASSWORD="${rdp_password}"
set -x

# Kali's default user needs non-interactive sudo for SCRT's apt steps.
echo "$KALI_USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-kali-nopasswd
chmod 440 /etc/sudoers.d/90-kali-nopasswd

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
# Prerequisites SCRT's scripts assume, plus zsh as the login shell.
apt-get install -y --no-install-recommends git curl wget zsh unzip tmux ca-certificates

# --- 1. Clone SCRT and stage its scripts/resources where they expect to be ----
sudo -u "$KALI_USER" git clone --depth 1 "$SCRT_REPO" "$KALI_HOME/SCRT" || true
if [ -d "$KALI_HOME/SCRT" ]; then
  cp -r "$KALI_HOME/SCRT/resources" "$KALI_HOME/resources"
  rm -rf /tmp/sources && cp -r "$KALI_HOME/SCRT/sources" /tmp/sources
  chown -R "$KALI_USER:$KALI_USER" "$KALI_HOME/resources" /tmp/sources
  chmod +x /tmp/sources/*.sh

  # --- 2. Run SCRT's own build scripts as the kali user ---------------------
  # Each is best-effort so one failed download doesn't leave the box unusable.
  run_scrt() { sudo -u "$KALI_USER" -H bash -lc "$1" || echo "WARN: $1 had errors"; }
  run_scrt "/tmp/sources/0-base.sh"      # apt tool suite (nmap, netexec, responder, ...)
  run_scrt "/tmp/sources/1-tools.sh"     # binaries: ffuf, sqlmap, chisel, peass, nvim, ...
  if [ "$INSTALL_BUGBOUNTY" = "true" ]; then
    run_scrt "/tmp/sources/2-tools.sh"   # httpx, subfinder, katana, dnsx, ...
  fi
  run_scrt "/tmp/sources/3-home.sh"      # shell: oh-my-zsh, starship, tmux.conf, aliases, fns
  rm -rf /tmp/sources
fi

# Make zsh the login shell (SCRT is a zsh environment).
chsh -s /usr/bin/zsh "$KALI_USER" || true

# --- 3. i3 desktop over xrdp + tmux ------------------------------------------
if [ "$ENABLE_GUI" = "true" ]; then
  apt-get install -y --no-install-recommends \
    xorg xserver-xorg xinit dbus-x11 \
    i3 i3status i3lock dmenu \
    xrdp xorgxrdp kitty fonts-powerline fonts-hack fonts-noto-color-emoji \
    x11-xserver-utils feh firefox-esr burpsuite dconf-cli || true

  # i3 launches from ~/.xsession, which xrdp's startwm.sh runs.
  cat > "$KALI_HOME/.xsession" <<'XSESSION'
#!/bin/sh
export TERMINAL=kitty
if command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- i3
else
  exec i3
fi
XSESSION
  chmod +x "$KALI_HOME/.xsession"

  # Minimal i3 config: Super as mod, kitty as terminal, dmenu launcher.
  mkdir -p "$KALI_HOME/.config/i3"
  cat > "$KALI_HOME/.config/i3/config" <<'I3CFG'
set $mod Mod4
font pango:Hack 10
exec --no-startup-id dbus-launch
bindsym $mod+Return exec kitty
bindsym $mod+d exec dmenu_run
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'
floating_modifier $mod
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bar {
    status_command i3status
    position top
}
I3CFG

  # Dark desktop: GTK 3/4 apps (file dialogs, Firefox chrome) read settings.ini;
  # libadwaita apps and Firefox's prefers-color-scheme read the dconf color-scheme.
  for v in 3.0 4.0; do
    mkdir -p "$KALI_HOME/.config/gtk-$v"
    cat > "$KALI_HOME/.config/gtk-$v/settings.ini" <<'GTK'
[Settings]
gtk-theme-name=Adwaita
gtk-application-prefer-dark-theme=1
GTK
  done
  mkdir -p /etc/dconf/profile /etc/dconf/db/local.d
  printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
  cat > /etc/dconf/db/local.d/00-dark <<'DCONF'
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita'
DCONF
  dconf update || true

  # Firefox: FoxyProxy force-installed and the built-in dark theme as the default,
  # via enterprise policy in the app's distribution dir, merged into any
  # policies.json already there.
  mkdir -p /usr/share/firefox-esr/distribution
  python3 - <<'PY'
import json, os
src = "/usr/share/firefox-esr/distribution/policies.json"
doc = json.load(open(src)) if os.path.exists(src) else {}
p = doc.setdefault("policies", {})
p.setdefault("ExtensionSettings", {})["foxyproxy@eric.h.jung"] = {
    "installation_mode": "force_installed",
    "install_url": "https://addons.mozilla.org/firefox/downloads/latest/foxyproxy-standard/latest.xpi",
}
prefs = p.setdefault("Preferences", {})
prefs["extensions.activeThemeID"] = {"Value": "firefox-compact-dark@mozilla.org", "Status": "default"}
prefs["layout.css.prefers-color-scheme.content-override"] = {"Value": 0, "Status": "default"}
certs = p.setdefault("Certificates", {}).setdefault("Install", [])
burp_ca = "/home/kali/.config/burp/burp-ca.der"
burp_ca in certs or certs.append(burp_ca)
json.dump(doc, open(src, "w"), indent=2)
PY

  # Burp's CA is per user and created the first time the operator opens Burp (and
  # accepts its licence), so it can't be fetched at boot. burp-trust saves the running
  # Burp's CA to the path the policy above installs from; i3 runs it at login and it
  # waits for Burp. Firefox reads policy certificates at startup.
  cat > /usr/local/bin/burp-trust <<'BURPTRUST'
#!/bin/sh
DEST="$HOME/.config/burp/burp-ca.der"
mkdir -p "$(dirname "$DEST")"
tries="$${BURP_TRUST_TRIES:-1}"
while [ "$tries" -gt 0 ]; do
  if curl -s --max-time 3 -o "$DEST.tmp" http://127.0.0.1:8080/cert && [ -s "$DEST.tmp" ]; then
    if cmp -s "$DEST.tmp" "$DEST"; then
      rm -f "$DEST.tmp"
    else
      mv "$DEST.tmp" "$DEST"
      echo "Burp CA saved to $DEST. Restart Firefox to trust it."
    fi
    exit 0
  fi
  tries=$((tries - 1))
  [ "$tries" -gt 0 ] && sleep 5
done
rm -f "$DEST.tmp"
echo "Burp is not listening on 127.0.0.1:8080." >&2
exit 1
BURPTRUST
  chmod 755 /usr/local/bin/burp-trust
  echo 'exec --no-startup-id env BURP_TRUST_TRIES=720 /usr/local/bin/burp-trust' >> "$KALI_HOME/.config/i3/config"

  # FoxyProxy import file: FoxyProxy Options tab > Import, then Save. Pushing these by policy
  # would put FoxyProxy in managed mode, which blocks switching proxies from the popup.
  cat > "$KALI_HOME/foxyproxy-lab.json" <<'FOXY'
{
  "mode": "disable",
  "sync": false,
  "autoBackup": false,
  "passthrough": "",
  "theme": "",
  "container": {},
  "commands": {},
  "data": [
    {"active": true, "title": "Burp", "type": "http", "hostname": "127.0.0.1", "port": "8080",
     "username": "", "password": "", "cc": "", "city": "", "color": "#ff6633", "pac": "", "pacString": "",
     "proxyDNS": true, "include": [], "exclude": [], "tabProxy": []},
    {"active": true, "title": "Tor", "type": "socks5", "hostname": "127.0.0.1", "port": "9050",
     "username": "", "password": "", "cc": "", "city": "", "color": "#7d4698", "pac": "", "pacString": "",
     "proxyDNS": true, "include": [], "exclude": [], "tabProxy": []},
    {"active": true, "title": "SOCKS", "type": "socks5", "hostname": "127.0.0.1", "port": "7000",
     "username": "", "password": "", "cc": "", "city": "", "color": "#3399ff", "pac": "", "pacString": "",
     "proxyDNS": true, "include": [], "exclude": [], "tabProxy": []}
  ]
}
FOXY
  chown "$KALI_USER:$KALI_USER" "$KALI_HOME/foxyproxy-lab.json"

  chown -R "$KALI_USER:$KALI_USER" "$KALI_HOME/.xsession" "$KALI_HOME/.config"

  # xrdp login needs a unix password for the kali user. Only set it when one was
  # supplied (from 1Password at apply time); otherwise leave GUI installed and let
  # the operator set it. Access is over Tailscale via the router; 3389 is never
  # exposed publicly (attacker has no public IP; SG ingress is ops-subnet only).
  # Tracing off for the whole secret-handling region: even `[ -n "$RDP_PASSWORD" ]`
  # would print the value. `echo` is a bash builtin, so nothing reaches the process
  # table either. Only the yes/no outcome survives into the log.
  set +x
  if [ -n "$RDP_PASSWORD" ]; then
    echo "$KALI_USER:$RDP_PASSWORD" | chpasswd
    RDP_PASSWORD_SET=yes
  else
    RDP_PASSWORD_SET=no
  fi
  unset RDP_PASSWORD
  set -x

  if [ "$RDP_PASSWORD_SET" = yes ]; then
    adduser xrdp ssl-cert 2>/dev/null || true
    systemctl enable --now xrdp
    echo "xrdp enabled; password for '$KALI_USER' set (value not traced)."
  else
    systemctl enable xrdp || true
    echo "NOTE: set a password for '$KALI_USER' then start xrdp to use RDP/i3."
  fi
fi

echo "attacker provisioning complete"
