#cloud-config
# Tailscale subnet router — the single human entry path (range-safety.md §3).
# It advertises the OPS subnet ONLY and never a detonation CIDR (ADR-0011 §4a), so
# the tailnet (and therefore the workstation, 1Password, and the age key) has no
# route into a detonation net. --accept-dns=false because VPC DNS is disabled and the
# box uses the public resolvers from the DHCP option set.
package_update: true
write_files:
  - path: /etc/sysctl.d/99-tailscale.conf
    content: |
      net.ipv4.ip_forward = 1
      net.ipv6.conf.all.forwarding = 1
runcmd:
  - sysctl -p /etc/sysctl.d/99-tailscale.conf
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey=${tailscale_auth_key} --advertise-routes=${ops_cidr} --hostname=${hostname} --accept-dns=false --ssh
