{
  "permissions": {
    "allow": [
      "Bash(terraform validate)",
      "Bash(terraform fmt:*)",
      "Bash(terraform output:*)",
      "Bash(terraform providers:*)",
      "Bash(terraform version)",
      "Bash(terraform state list:*)",
      "Bash(terraform state show:*)",
      "Bash(terraform -chdir=:*)",
      "Bash(tflint:*)",
      "Bash(infracost breakdown:*)",
      "Bash(infracost output:*)",
      "Bash(aws ec2 describe-:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws ce get-:*)",
      "Bash(aws budgets describe-:*)",
      "Bash(tailscale status:*)",
      "Bash(tailscale ip:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(bash _hack/scripts/iac-lint.sh)",
      "Bash(yamllint:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/_hack/scripts/guard-mutations.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.tf) terraform fmt \"$f\" >/dev/null 2>&1 || true ;; *.yaml|*.yml) yamllint \"$f\" ;; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agentic-awesome-skills@agentic-awesome-skills": false,
    "agentic-bundle-security-engineer@agentic-awesome-skills": true,
    "agentic-bundle-aas-observability-ir@agentic-awesome-skills": true,
    "claude-code-setup@claude-plugins-official": true
  }
}
