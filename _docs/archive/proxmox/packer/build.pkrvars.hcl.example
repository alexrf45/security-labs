# Copy to build.pkrvars.hcl (gitignored / SOPS-encrypted) and fill in.
# Secrets (token secret, win admin pw) are best injected via `op run` instead.
#   op run -- packer build -var-file=build.pkrvars.hcl -only='proxmox-iso.ubuntu-base' .

proxmox_url      = "https://192.168.20.6:8006/api2/json"
proxmox_node     = "pve01"
proxmox_token_id = "terraform@pve!tf" # an API token with VM.*, Datastore.AllocateSpace, SDN.Use

# proxmox_token_secret = "..."   # prefer: op run -- ... (TF/PKR_VAR from 1Password)
# winadmin_password    = "..."   # build-time only

iso_storage_pool     = "local"     # node-local content store holding ISOs
node_local_datastore = "local-lvm" # template disks — NEVER a TrueNAS-backed store
build_bridge         = "vmbr0"     # egress-capable build net; NEVER a detonation VLAN

# Linux ISO checksums (from the distro SHA256SUMS):
# ubuntu_iso_checksum = "sha256:..."
# debian_iso_checksum = "sha256:..."

# Windows ISOs pre-staged on the node-local content store (see README):
# win2022_iso = "local:iso/SERVER_EVAL_x64FRE_en-us.iso"
# win10_iso   = "local:iso/Win10_22H2_EnglishInternational_x64.iso"
# win11_iso   = "local:iso/Win11_24H2_EnglishInternational_x64.iso"
# virtio_iso  = "local:iso/virtio-win.iso"
